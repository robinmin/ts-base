{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "lib": ["ESNext"],
        "types": ["bun"],
        "target": "ESNext",
        "module": "Preserve",
        "moduleDetection": "force",
        "allowJs": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": false,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noPropertyAccessFromIndexSignature": false
    },
    // Template-CI only: typechecks the flat scaffolds in place so
    // `bun run typecheck:scaffolds` exercises them before promotion.
    // The cli/mono scaffolds use workspace aliases that only resolve after
    // setup, so they're covered by `bun run test:setup` instead.
    "include": ["src-app", "src-lib"]
}

{
    "name": "@SCOPE/root",
    "type": "module",
    "private": true,
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "prepare": "lefthook install",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "lint": "biome check . && turbo run typecheck",
        "format": "biome check . --write",
        "autofix": "bun run format && turbo run typecheck",
        "check": "bun run lint && bun run test"
    },
    "devDependencies": {
        "@types/bun": "1.3.14",
        "turbo": "^2.9.14"
    }
}

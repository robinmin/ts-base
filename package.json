{
    "name": "ts-base",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "setup": "bun run scripts/setup.ts",
        "clean": "bun run scripts/clean.ts",
        "prepare": "lefthook install",
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "pretest": "bun run scripts/ensure-scaffold-installs.ts",
        "test": "NODE_ENV=test bun test --coverage --coverage-dir=.coverage --reporter=dots",
        "test:full": "NODE_ENV=test bun test --update-snapshots --coverage --coverage-dir=.coverage",
        "test:setup": "bun run scripts/test-setup.ts",
        "typecheck": "tsc --noEmit",
        "typecheck:scaffolds": "tsc --noEmit -p tsconfig.template.json",
        "lint": "biome check . && bun run typecheck && bun run typecheck:scaffolds",
        "format": "biome check . --write",
        "autofix": "bun run format && bun run typecheck",
        "check": "bun run lint && bun run test"
    },
    "devDependencies": {
        "@types/bun": "1.3.14"
    },
    "dependencies": {
        "zod": "^3.24.0"
    }
}

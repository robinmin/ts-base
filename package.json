{
    "name": "ts-base",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "license": "Apache-2.0",
    "scripts": {
        "setup": "bun run scripts/ts-base.ts setup",
        "clean": "bun run scripts/ts-base.ts clean",
        "prepare": "lefthook install",
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "pretest": "bun run scripts/ts-base.ts ensure-scaffold-installs",

        "test": "NODE_ENV=test bun test --coverage --coverage-dir=.coverage --reporter=dots",
        "test-pre-check": "spur rule run --preset recommended-pre-check --fail-on warning --verbose",
        "test-post-check": "spur rule run --preset recommended-post-check --fail-on warning --verbose",
        "spur-check": "bun run lint && bun run test-pre-check && bun run test && bun run test-post-check",
        "check": "bun run lint && bun run test",

        "test:full": "NODE_ENV=test bun test --update-snapshots --coverage --coverage-dir=.coverage",
        "test-pre-check:full": "spur rule run --preset recommended-pre-check --fail-on warning --verbose",
        "test-post-check:full": "spur rule run --preset recommended-post-check --fail-on warning --verbose",
        "check:full": "bun run lint && bun run test:full",

        "test:setup": "bun run scripts/ts-base.ts test-setup",
        "typecheck": "tsc --noEmit",
        "typecheck:scaffolds": "tsc --noEmit -p tsconfig.template.json",
        "lint": "biome check . --error-on-warnings && bun run typecheck && bun run typecheck:scaffolds",
        "format": "biome check . --write",
        "autofix": "bun run format && bun run typecheck"
    },
    "devDependencies": {
        "@types/bun": "1.3.14"
    },
    "dependencies": {
        "zod": "^3.24.0"
    }
}
